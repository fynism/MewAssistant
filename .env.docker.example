# Copy this file to .env on the ECS and replace the credentials.
# URL-encode special characters in POSTGRES_PASSWORD and REDIS_PASSWORD when
# inserting them into DATABASE_URL and REDIS_URL.
POSTGRES_PASSWORD=replace-with-strong-password
REDIS_PASSWORD=replace-with-strong-password
MINIO_ROOT_USER=replace-with-minio-user
MINIO_ROOT_PASSWORD=replace-with-strong-minio-password
DATABASE_URL=postgresql+psycopg2://postgres:replace-with-strong-password@postgres:5432/langchain_app
REDIS_URL=redis://:replace-with-strong-password@redis:6379/0

JWT_SECRET_KEY=replace-with-a-random-secret
ADMIN_INVITE_CODE=replace-with-a-random-admin-invite-code
ARK_API_KEY=replace-with-your-model-api-key
MODEL=replace-with-your-model-name
BASE_URL=https://your-openai-compatible-api.example/v1

MILVUS_HOST=standalone
MILVUS_PORT=19530
MILVUS_COLLECTION=embeddings_collection
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
DENSE_EMBEDDING_DIM=1024

# Optional remote rerank service.
# RERANK_MODEL=your-rerank-model
# RERANK_BINDING_HOST=https://your-rerank-api.example/v1/rerank
# RERANK_API_KEY=your-rerank-api-key
