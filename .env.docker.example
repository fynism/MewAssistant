# Copy this file to separate private staging.env and production.env files.
# Build and push this application image from a development/CI machine first.
SUPERMEW_APP_IMAGE=docker.io/YOUR_DOCKERHUB_USERNAME/supermew:v0.1.0-cpu

# Copy to a separate, private file for each environment. Keep the two volume
# directories and all host ports distinct. These ports bind to 127.0.0.1 only.
SUPERMEW_ENV_NAME=staging
DOCKER_VOLUME_DIRECTORY=/opt/supermew-data/staging
APP_BIND_PORT=8001
POSTGRES_BIND_PORT=15432
REDIS_BIND_PORT=16379
MILVUS_BIND_PORT=19531
MILVUS_HEALTH_BIND_PORT=19091
ATTU_BIND_PORT=18080
# Optional: override third-party image locations if you mirror them to Docker Hub.
# POSTGRES_IMAGE=YOUR_DOCKERHUB_USERNAME/postgres:15
# REDIS_IMAGE=YOUR_DOCKERHUB_USERNAME/redis:7-alpine
# ETCD_IMAGE=YOUR_DOCKERHUB_USERNAME/etcd:v3.5.18
# MINIO_IMAGE=YOUR_DOCKERHUB_USERNAME/minio:RELEASE.2024-05-28T17-19-04Z
# MILVUS_IMAGE=YOUR_DOCKERHUB_USERNAME/milvus:v2.5.14
# ATTU_IMAGE=YOUR_DOCKERHUB_USERNAME/attu:v2.5.11
# URL-encode special characters in POSTGRES_PASSWORD and REDIS_PASSWORD when
# inserting them into DATABASE_URL and REDIS_URL.
POSTGRES_PASSWORD=replace-with-strong-password
REDIS_PASSWORD=replace-with-strong-password
MINIO_ROOT_USER=replace-with-minio-user
MINIO_ROOT_PASSWORD=replace-with-strong-minio-password
DATABASE_URL=postgresql+psycopg2://postgres:replace-with-strong-password@postgres:5432/langchain_app
REDIS_URL=redis://:replace-with-strong-password@redis:6379/0
REDIS_KEY_PREFIX=supermew_staging

JWT_SECRET_KEY=replace-with-a-random-secret
# Initial administrator is created with backend.admin_bootstrap after migration.
ARK_API_KEY=replace-with-your-model-api-key
MODEL=replace-with-your-model-name
BASE_URL=https://your-openai-compatible-api.example/v1

# Remote MCP: enable only after HTTPS proxy and client acceptance.
MCP_EXTERNAL_ENABLED=false
MCP_PUBLIC_BASE_URL=https://knowledge.example.com
MCP_ALLOWED_HOSTS=knowledge.example.com,localhost:*,127.0.0.1:*
MCP_ALLOWED_ORIGINS=

MILVUS_HOST=standalone
MILVUS_PORT=19530
MILVUS_COLLECTION=embeddings_collection
MILVUS_M1_COLLECTION=embeddings_collection_m1
BM25_M1_STATE_PATH=/app/data/bm25_state_m1.json
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
DENSE_EMBEDDING_DIM=1024

# Optional remote rerank service.
# RERANK_MODEL=your-rerank-model
# RERANK_BINDING_HOST=https://your-rerank-api.example/v1/rerank
# RERANK_API_KEY=your-rerank-api-key
