# Add this location inside the HTTPS server block for MCP_PUBLIC_BASE_URL.
# The application listens on 127.0.0.1:8000 in docker-compose.yml.
location = /mcp/knowledge {
    proxy_pass http://127.0.0.1:8000/mcp/knowledge;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Accept $http_accept;
    proxy_set_header Mcp-Protocol-Version $http_mcp_protocol_version;
    proxy_set_header Mcp-Method $http_mcp_method;
    proxy_set_header Mcp-Name $http_mcp_name;
    proxy_set_header Mcp-Session-Id $http_mcp_session_id;
    proxy_set_header X-Forwarded-Proto https;
    proxy_buffering off;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
}
