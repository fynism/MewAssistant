# ==================== LLM 大模型 ====================
# 支持任何 OpenAI 兼容 API（DeepSeek / 豆包 / OpenAI 等）
ARK_API_KEY= # sk-xxx
MODEL= # deepseek-v4-pro
GRADE_MODEL= # deepseek-v4-flash
FAST_MODEL= # deepseek-v4-flash
BASE_URL= # https://api.deepseek.com

# ==================== 本地稠密向量 ====================
EMBEDDING_MODEL= # BAAI/bge-m3
EMBEDDING_DEVICE= # cpu
DENSE_EMBEDDING_DIM= # 1024
# HF_HUB_OFFLINE= 1  # 本地调试时打开；首次部署必须注释掉

# ==================== Rerank 重排序（可选，不配则自动降级）====================
RERANK_MODEL= # jina-reranker-v3
RERANK_BINDING_HOST= # https://api.jina.ai/v1/rerank
RERANK_API_KEY= # jina_xxx

# ==================== Milvus 向量数据库 ====================
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION= # embeddings_collection
MILVUS_M1_COLLECTION=embeddings_collection_m1

# ==================== PostgreSQL 数据库 ====================
# 密码需与 docker-compose.yml 中 POSTGRES_PASSWORD 一致
DATABASE_URL=postgresql+psycopg2://postgres:<替换为强密码>@127.0.0.1:5432/langchain_app

# ==================== Redis 缓存 ====================
# 密码需与 docker-compose.yml 中 REDIS_PASSWORD 一致（本地可不设密码）
REDIS_URL=redis://:<替换为强密码>@127.0.0.1:6379/0
# 本地无密码写法：redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=supermew
REDIS_CACHE_TTL_SECONDS=300

# ==================== JWT 鉴权（生产环境务必替换为强随机密钥）====================
# 生成方式：openssl rand -hex 32
JWT_SECRET_KEY=<替换为随机强密钥>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ==================== GitHub 登录（可选，首次授权免邀请码注册）====================
# 在 GitHub Settings > Developer settings > OAuth Apps 创建应用。
# Callback URL 必须与 GITHUB_REDIRECT_URI 完全一致；本地可用 http://127.0.0.1:8000。
GITHUB_OAUTH_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://你的域名/auth/github/callback

# ==================== 远程知识库 MCP ====================
# 完成 HTTPS 反向代理、迁移与 Codex 联调后再启用。
MCP_EXTERNAL_ENABLED=false
MCP_PUBLIC_BASE_URL=https://knowledge.example.com
# 逗号分隔；Host 可使用端口通配符，必须包含对外域名。
MCP_ALLOWED_HOSTS=knowledge.example.com,localhost:*,127.0.0.1:*
# 非浏览器客户端通常不发 Origin；仅列出确实允许的浏览器来源。
MCP_ALLOWED_ORIGINS=

# ==================== 密码哈希 ====================
PASSWORD_PBKDF2_ROUNDS=310000

# 管理员通过一次性命令创建，邀请码由管理员登录后发放。

# ==================== 请求和 SQL 日志 ====================
LOG_REQUESTS=true
LOG_SQL=false
# 仅在本地排查时开启；可能记录密码、邀请码等绑定参数。
LOG_SQL_PARAMETERS=false

# ==================== Auto-Merging 自动合并 ====================
AUTO_MERGE_ENABLED=true
AUTO_MERGE_THRESHOLD=2
LEAF_RETRIEVE_LEVEL=3

# ==================== 高德天气 API（可选）====================
AMAP_WEATHER_API=https://restapi.amap.com/v3/weather/weatherInfo
AMAP_API_KEY= # 你的高德 key

# ==================== BM25 稀疏统计持久化（可选）====================
BM25_M1_STATE_PATH=data/bm25_state_m1.json
MAX_UPLOAD_BYTES=20971520

# ==================== PDF OCR 与清洗（本地 CPU）====================
PDF_OCR_MODE=auto
PDF_OCR_DPI=200
PDF_OCR_RETRY_DPI=300
PDF_OCR_MAX_SIDE=3500
PDF_OCR_MIN_TEXT_CHARS=40
PDF_OCR_ACCEPT_SCORE=0.55
PDF_OCR_WARNING_SCORE=0.75
PDF_REMOVE_REPEATED_MARGINS=true
MAX_PDF_PAGES=300
