# ==================== LLM 大模型 ====================
# 支持任何 OpenAI 兼容 API（DeepSeek / 豆包 / OpenAI 等）
ARK_API_KEY= # sk-xxx
MODEL= # deepseek-v4-pro
GRADE_MODEL= # deepseek-v4-flash
FAST_MODEL= # deepseek-v4-flash
BASE_URL= # https://api.deepseek.com

# ==================== 本地稠密向量 ====================
EMBEDDING_MODEL= # BAAI/bge-m3
EMBEDDING_DEVICE= # cpu
DENSE_EMBEDDING_DIM= # 1024
# HF_HUB_OFFLINE= 1  # 本地调试时打开；首次部署必须注释掉

# ==================== Rerank 重排序（可选，不配则自动降级）====================
RERANK_MODEL= # jina-reranker-v3
RERANK_BINDING_HOST= # https://api.jina.ai/v1/rerank
RERANK_API_KEY= # jina_xxx

# ==================== Milvus 向量数据库 ====================
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION= # embeddings_collection

# ==================== PostgreSQL 数据库 ====================
# 密码需与 docker-compose.yml 中 POSTGRES_PASSWORD 一致
DATABASE_URL=postgresql+psycopg2://postgres:<替换为强密码>@127.0.0.1:5432/langchain_app

# ==================== Redis 缓存 ====================
# 密码需与 docker-compose.yml 中 REDIS_PASSWORD 一致（本地可不设密码）
REDIS_URL=redis://:<替换为强密码>@127.0.0.1:6379/0
# 本地无密码写法：redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=supermew
REDIS_CACHE_TTL_SECONDS=300

# ==================== JWT 鉴权（生产环境务必替换为强随机密钥）====================
# 生成方式：openssl rand -hex 32
JWT_SECRET_KEY=<替换为随机强密钥>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ==================== 密码哈希 ====================
PASSWORD_PBKDF2_ROUNDS=310000

# ==================== 管理员邀请码 ====================
ADMIN_INVITE_CODE=supermew-admin-2026

# ==================== Auto-Merging 自动合并 ====================
AUTO_MERGE_ENABLED=true
AUTO_MERGE_THRESHOLD=2
LEAF_RETRIEVE_LEVEL=3

# ==================== 高德天气 API（可选）====================
AMAP_WEATHER_API=https://restapi.amap.com/v3/weather/weatherInfo
AMAP_API_KEY= # 你的高德 key

# ==================== BM25 稀疏统计持久化（可选）====================
# BM25_STATE_PATH=/path/to/bm25_state.json
